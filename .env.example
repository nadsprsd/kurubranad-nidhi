# Copy this file to .env.local for local development, and set the same
# variables in Vercel Project Settings → Environment Variables for
# Preview/Production. Never commit a real .env.local file.

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Analytics only loads client-side after visitor consent — see
# components/layout/analytics-consent.tsx and lib/analytics.ts.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console HTML tag verification token (the content value only,
# not the full <meta> tag). Alternatively verify via DNS — see README.
NEXT_PUBLIC_GSC_VERIFICATION=
